# Password Vault — Environment Variables
# Copy this file to .env and fill in your values.
# KHÔNG commit file .env vào Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vault_user
DB_PASSWORD=
DB_NAME=password_vault
DB_POOL_SIZE=5

VAULT_AUTOLOCK_MINUTES=10

LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8765
