{
  "name": "password-vault",
  "version": "1.0.0",
  "description": "Password Vault — Electron desktop credential store with local autofill",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev:desktop": "electron-forge start",
    "build": "tsc --build",
    "build:tools": "tsc -p tsconfig.tools.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/ migrations/",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:ipc": "vitest run --project ipc",
    "test:native-host": "vitest run --project native-host",
    "test:windows": "vitest run --project windows",
    "package:windows": "electron-forge package --platform win32 --arch x64",
    "make:windows": "electron-forge make --platform win32 --arch x64",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:plan": "tsx scripts/migrate.ts plan",
    "db:baseline": "tsx scripts/migrate.ts baseline",
    "db:migrate:up": "tsx scripts/migrate.ts up",
    "db:migrate:verify": "tsx scripts/migrate.ts verify",
    "db:migrate:down": "tsx scripts/migrate.ts down"
  },
  "keywords": [
    "password",
    "vault",
    "electron",
    "autofill"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "dotenv": "^18.0.5",
    "electron-squirrel-startup": "^1.0.1",
    "fastify": "^5.12.5",
    "koffi": "^3.3.2",
    "mariadb": "^3.5.4",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.6.4",
    "css-loader": "^7.1.5",
    "electron": "^44.5.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
